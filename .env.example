# Copie para .env e ajuste os valores. Consumido pelo docker-compose.yml.

# Banco de dados (Postgres)
POSTGRES_DB=stacktrack
POSTGRES_USER=stacktrack
POSTGRES_PASSWORD=troque-esta-senha

# Pool de conexões da API. Sem estas variáveis valem os padrões do projeto
# (10/2/60min/30min/60s) — que já são uma decisão, ao contrário do padrão do
# pgx, que seria max(4, núcleos de CPU). Só mexa com número na mão: o teto do
# Postgres (max_connections, 100 por padrão) é compartilhado com o job de
# migration e com qualquer psql aberto.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME_MIN=60
# DB_MAX_CONN_IDLE_MIN=30
# DB_HEALTHCHECK_SEC=60

# Onde os arquivos anexados aos cards são gravados. O compose já aponta para um
# volume próprio do container; mexer aqui é para quem roda a API fora do Docker.
# ANEXOS_DIR=/var/lib/stacktrack/anexos

# --- Perímetro (A1/A4) ----------------------------------------------------
#
# Em DESENVOLVIMENTO os padrões já servem, e nada aqui precisa ser preenchido.
# Em PRODUÇÃO a API recusa subir se qualquer um destes tetos estiver em zero ou
# se PROXIES_CONFIAVEIS estiver vazia — ver config.Validar.

# De onde a API aceita o cabeçalho X-Real-IP com o IP do cliente (CIDRs ou IPs,
# separados por vírgula). Vazia = não confia em ninguém, e o IP do cliente passa
# a ser sempre o peer direto da conexão. É o certo em desenvolvimento, onde não
# há proxy; em produção, sem ela, todo mundo cai no balde do IP do proxy.
# Prefira o IP exato do proxy ou a sub-rede exata da bridge; nao confie em toda
# 172.16.0.0/12, que pode incluir containers de outros projetos.
# PROXIES_CONFIAVEIS=172.20.0.2

# Cookies de sessão DESCONHECIDOS que um mesmo IP pode apresentar antes de levar
# 429. Conferido antes da consulta ao banco.
# RATE_LIMIT_SESSAO_DESCONHECIDA=30

# Orçamentos de tempo, em milissegundos.
# PRAZO_REQUISICAO_MS=10000
# PRAZO_UPLOAD_MS=120000
# TEMPO_CONEXAO_BANCO_MS=2000
# ESPERA_LOCK_QUADRO_MS=2000
# TEMPO_MAXIMO_COMANDO_MS=5000

# Tempo real: ocupação simultânea e tentativas de handshake.
# WS_CONEXOES_POR_CONTA=5
# WS_CONEXOES_SIMULTANEAS=100
# WS_HANDSHAKES_POR_MINUTO=10

# Margem mínima no volume de anexos. Abaixo dela a MUTAÇÃO é recusada com 507 e
# a leitura continua. Valem os dois pisos, e prevalece o mais conservador.
# DISCO_MINIMO_BYTES=2147483648
# DISCO_MINIMO_POR_CEM=10
# DISCO_MEDICAO_VALIDADE_SEG=10

# Faxina periódica (sessões vencidas e convites terminais), fora de qualquer
# requisição.
# FAXINA_INTERVALO_MIN=60
# FAXINA_PRAZO_SEG=60

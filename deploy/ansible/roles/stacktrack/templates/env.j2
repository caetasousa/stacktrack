# ATENÇÃO: arquivo gerado pelo Ansible (deploy/ansible/roles/stacktrack).
# Editar aqui não adianta — o próximo `make infra-apply` sobrescreve.
# Para mudar um valor, mexa em group_vars/producao/ e reaplique.
#
# O modelo comentado, com a explicação de cada variável, é o .env.prod.example
# do repositório.

DOMINIO={{ dominio }}

# Gravados pelo initdb no volume do Postgres na PRIMEIRA subida da stack.
# Mudá-los aqui depois não muda o papel no banco: só quebra a conexão da API.
POSTGRES_DB={{ vault_postgres_db }}
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}

# O papel de RUNTIME: só DML, sem DDL. Quem migra continua sendo o dono acima —
# o Flyway usa POSTGRES_USER, a API usa estes dois.
#
# Ao contrário dos de cima, estes NÃO vêm do initdb: quem cria e mantém o papel
# é deploy/postgres/papeis.sql, aplicado pelo playbook a cada provisionamento.
# Trocar a senha é editar o vault e reaplicar.
DB_USER={{ vault_db_app_user }}
DB_PASSWORD={{ vault_db_app_password }}

# A versão QUE ESTÁ NO AR, lida do container em execução — não um `latest` fixo.
#
# O `stacktrack-release release <sha>` passa o SHA por variável de ambiente no
# momento do deploy; o que mudou é que o playbook não desfaz mais isso. Com
# `latest` gravado aqui, um `infra-apply` que recriasse os containers subiria a
# imagem `latest` do disco do servidor, que pode ser bem mais velha que a que
# estava rodando — e foi o que aconteceu uma vez.
#
# Num host onde nada roda, vale o `imagem_tag` do group_vars.
IMAGE_REPO={{ imagem_repo }}
IMAGE_TAG={{ stacktrack_imagem_tag }}

# Envio de email dos convites. Com SMTP_HOST vazio o envio fica desligado e o
# convite sai só com o link manual. O usuário, a senha e a chave que cifra a
# fila vêm do vault; o resto, de group_vars/producao/vars.yml.
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_porta | default(587) }}
SMTP_USER={{ vault_smtp_usuario | default('') }}
SMTP_PASSWORD={{ vault_smtp_senha | default('') }}
SMTP_STARTTLS=true
EMAIL_REMETENTE={{ email_remetente | default('') }}
EMAIL_REMETENTE_NOME={{ email_remetente_nome | default('stacktrack') }}
# A chave da fila de emails (AES-256). Trocá-la torna ilegíveis as mensagens
# que ainda estiverem na fila — elas falham e o dono reenvia. Não é perda de
# dado: o link de cada convite continua valendo.
EMAIL_CHAVE={{ vault_email_chave | default('') }}


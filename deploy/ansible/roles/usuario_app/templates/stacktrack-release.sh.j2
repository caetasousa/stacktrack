#!/usr/bin/env bash
# ATENÇÃO: arquivo gerado pelo Ansible (roles/usuario_app). Editar no
# servidor não adianta — o próximo `make infra-preparar` sobrescreve.
#
# O ÚNICO comando que a esteira consegue executar neste servidor.
#
# A chave do CI está no authorized_keys do usuário da aplicação com
# `command="..."` apontando para cá e com `restrict`: não há shell, não há scp,
# não há port forwarding, não há agente. A restrição é da CHAVE — a mesma conta
# aceita a chave do operador sem limite nenhum. O que o cliente pediu chega em SSH_ORIGINAL_COMMAND, e este script
# decide se aquilo é uma das operações de release — ou nada.
#
# Por que isso importa: o job de deploy anterior abria um shell no servidor e
# mandava linhas de comando montadas no runner. Quem tivesse a chave tinha a
# máquina — que roda a borda Traefik e os outros sites do VPS. Aqui, quem tem a
# chave tem quatro verbos, e o único que escreve arquivo (`sync`) só aceita o
# `docker-compose.prod.yml` e o passa por uma allowlist antes de instalar.
#
# O script serve os DOIS caminhos de invocação, de propósito:
#
#   - chamado por SSH com comando forçado → lê SSH_ORIGINAL_COMMAND
#   - chamado direto, com argumentos      → usa "$@"
#
# É o que permite trocar o usuário da esteira sem trocar o job da esteira no
# mesmo instante: a linha que o CI manda é a mesma nos dois mundos.

set -euo pipefail

USUARIO_APP={{ usuario_app | quote }}
PASTA_STACK={{ pasta_stack | quote }}
PASTA_SCRIPTS={{ pasta_scripts | quote }}
COMPOSE="docker compose -f docker-compose.prod.yml"

recusa() {
	echo "stacktrack-release: $1" >&2
	echo "verbos aceitos: release <sha|latest> · sync · backup · estado" >&2
	exit 2
}

# --- quem chama, e como ------------------------------------------------------

if [ "$#" -gt 0 ]; then
	argumentos=("$@")
elif [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
	# `read -ra` e não `eval`: a linha do cliente é dado, não código. Com `eval`,
	# um `release; rm -rf /` seria obedecido — que é exatamente o que o comando
	# forçado existe para impedir.
	read -ra argumentos <<<"$SSH_ORIGINAL_COMMAND"
else
	recusa "nenhum comando"
fi

# O cliente pode nomear o wrapper antes do verbo — e nomeia, porque a MESMA
# linha precisa funcionar nos dois mundos:
#
#   com comando forçado   o sshd ignora o que veio e executa este arquivo, que
#                         acha o nome no início de SSH_ORIGINAL_COMMAND
#   sem comando forçado   o shell do usuário resolve `stacktrack-release` pelo
#                         PATH e o nome vira o $0, não um argumento
#
# É o que permite trocar o usuário e a chave da esteira sem trocar o job da
# esteira no mesmo instante.
if [ "$(basename -- "${argumentos[0]:-}")" = "stacktrack-release" ]; then
	argumentos=("${argumentos[@]:1}")
fi

# Reposiciona os argumentos e passa a ler por $1, $2 e $#.
#
# O motivo é este arquivo ser um TEMPLATE. A forma do bash para contar um array
# — cifrão, chave, jogo da velha — abre, para o Jinja, um comentário que nunca
# fecha, e a renderização morre com "Missing end of comment tag". Nem em
# comentário de bash ela pode aparecer: o Jinja lê o arquivo inteiro, não o
# shell. `$#` diz a mesma coisa sem a sequência.
set -- ${argumentos[@]+"${argumentos[@]}"}

verbo=${1:-}
alvo=${2:-}

if [ "$#" -gt 2 ]; then
	recusa "argumentos demais"
fi

# --- quem executa ------------------------------------------------------------
#
# A esteira entra JÁ como o usuário da aplicação: a chave dela está no
# authorized_keys dessa conta, presa a este arquivo. Então normalmente não há
# troca de usuário nenhuma aqui.
#
# O `sudo` cobre só o caso de alguém chamar o wrapper de outra conta — root,
# tipicamente, testando. Se não houver permissão, o comando falha em vez de
# rodar com o usuário errado.
if [ "$(id -un)" != "$USUARIO_APP" ]; then
	exec sudo -n -u "$USUARIO_APP" "$0" "$verbo" ${alvo:+"$alvo"}
fi

cd "$PASTA_STACK"

# --- pré-voo ----------------------------------------------------------------
#
# O release pressupõe um host provisionado pelo Ansible: ele não cria o .env nem
# sabe a senha do banco. Sem esta conferência, um host não provisionado deixaria
# o `up -d` subir a stack com TODAS as variáveis vazias — o Postgres nasce sem
# senha, a API não conecta, e o deploy segue verde até a verificação final falhar
# por um motivo que não aponta para a causa.
preVoo() {
	local faltando=""
	[ -f "$PASTA_STACK/.env" ] || faltando="$faltando .env"
	[ -f "$PASTA_STACK/docker-compose.prod.yml" ] || faltando="$faltando docker-compose.prod.yml"
	docker network inspect {{ rede_borda | quote }} >/dev/null 2>&1 || faltando="$faltando rede-{{ rede_borda }}"
	grep -Eq '^PROXIES_CONFIAVEIS=.+' "$PASTA_STACK/.env" 2>/dev/null || faltando="$faltando PROXIES_CONFIAVEIS"
	grep -Eq '^DB_USER=.+' "$PASTA_STACK/.env" 2>/dev/null || faltando="$faltando DB_USER"
	if [ -n "$faltando" ]; then
		echo "host não provisionado (faltando:$faltando). Rode: make infra-apply" >&2
		exit 1
	fi
}

case "$verbo" in
release)
	# `latest` serve ao provisionamento manual; a esteira sempre manda o SHA,
	# que é o que faz o servidor subir EXATAMENTE o artefato testado, e não um
	# `latest` que pode ter mudado no meio do caminho.
	if [ "$alvo" != "latest" ] && ! [[ "$alvo" =~ ^[0-9a-f]{7,40}$ ]]; then
		recusa "referência de release inválida: ${alvo:-<vazia>}"
	fi
	preVoo

	# Retrato do banco ANTES da migration. O cron diário sozinho deixa uma
	# janela de até 24 horas: um deploy ruim ao meio-dia teria como ponto de
	# retorno o estado da madrugada. Não trava o release — num host onde a
	# stack ainda não existe não há o que salvar.
	"$PASTA_SCRIPTS/backup.sh" || echo "aviso: backup pré-release não executado" >&2

	export IMAGE_TAG="$alvo"
	$COMPOSE pull --quiet
	# API e web param JUNTAS antes do Flyway. As migrations expansivas deixam o
	# binário anterior iniciar, mas isso não basta para protocolos: durante a
	# V16, por exemplo, o backend antigo gravaria eventos sem revisão que o
	# cliente novo não poderia usar como cursor.
	$COMPOSE stop web api
	$COMPOSE up -d
	docker image prune -f
	echo "release $alvo no ar"
	;;

sync)
	# A esteira entrega SÓ o docker-compose.prod.yml, pelo stdin. É o único
	# arquivo que ela escreve, e não tem segredo — o .env, o backup.sh e os
	# papéis do banco continuam vindo só do Ansible.
	#
	# O compose É código: pode montar o disco do host, subir container
	# privilegiado, trocar a imagem. Por isso passa por uma allowlist contra a
	# FORMA CANÔNICA (`docker compose config`, que resolve variáveis e defaults)
	# antes de ser instalado. Uma chave da esteira roubada não escapa dela.
	[ -z "$alvo" ] || recusa "sync não recebe argumento"
	[ -f "$PASTA_STACK/.env" ] || { echo "sync: host sem .env — rode make infra-apply" >&2; exit 1; }
	command -v python3 >/dev/null || recusa "sync: python3 ausente no servidor"

	novo=$(mktemp)
	canon=$(mktemp)
	trap 'rm -f "$novo" "$canon"' EXIT
	cat >"$novo"
	[ -s "$novo" ] || recusa "sync: nada no stdin"

	docker compose --env-file "$PASTA_STACK/.env" -f "$novo" config --format json >"$canon" 2>/dev/null \
		|| recusa "sync: compose não valida contra o .env do servidor"

	python3 - "$canon" {{ ghcr_usuario | quote }} <<'PY' || recusa "sync: bloqueado pela allowlist (ver acima)"
import json, sys
canon, owner = sys.argv[1], sys.argv[2]
d = json.load(open(canon))
caps_ok = {"CHOWN", "DAC_OVERRIDE", "FOWNER", "SETGID", "SETUID"}
ruins = []
for nome, s in (d.get("services") or {}).items():
    img = s.get("image", "")
    if not (img.startswith("ghcr.io/%s/" % owner) or img.startswith("postgres:")):
        ruins.append("%s: imagem fora da allowlist (%s)" % (nome, img))
    if s.get("privileged"):
        ruins.append("%s: privileged" % nome)
    for k in ("pid", "ipc", "network_mode", "userns_mode"):
        if str(s.get(k, "")).endswith("host"):
            ruins.append("%s: %s=host" % (nome, k))
    if s.get("devices"):
        ruins.append("%s: devices" % nome)
    for cap in s.get("cap_add") or []:
        if str(cap).upper() not in caps_ok:
            ruins.append("%s: capability %s" % (nome, cap))
    for so in s.get("security_opt") or []:
        if "unconfined" in str(so):
            ruins.append("%s: security_opt %s" % (nome, so))
    for v in s.get("volumes") or []:
        if isinstance(v, dict) and v.get("type") == "bind":
            ruins.append("%s: bind mount %s" % (nome, v.get("source")))
        if isinstance(v, str) and v[:1] in "/.~$":
            ruins.append("%s: bind mount %s" % (nome, v))
if ruins:
    sys.stderr.write("sync: " + "; ".join(ruins) + "\n")
    sys.exit(1)
PY

	install -m 0644 "$novo" "$PASTA_STACK/docker-compose.prod.yml"
	echo "compose sincronizado"
	;;

backup)
	[ -z "$alvo" ] || recusa "backup não recebe argumento"
	preVoo
	"$PASTA_SCRIPTS/backup.sh"
	;;

estado)
	[ -z "$alvo" ] || recusa "estado não recebe argumento"
	$COMPOSE ps

	# As impressões digitais dos arquivos da stack.
	#
	# O `docker-compose.prod.yml` a esteira entrega pelo `sync` a cada deploy, então
	# o hash dele aqui é só informativo. O `backup.sh` é do Ansible, e a esteira
	# compara: mudou o backup.sh sem `make infra-apply` e o deploy falha, em vez de
	# rodar código de backup que não é o do commit.
	for arquivo in \
		"$PASTA_STACK/docker-compose.prod.yml" \
		"$PASTA_SCRIPTS/backup.sh"; do
		if [ -f "$arquivo" ]; then
			printf 'sha256 %s %s\n' "$(basename "$arquivo")" "$(sha256sum "$arquivo" | cut -d" " -f1)"
		else
			printf 'sha256 %s AUSENTE\n' "$(basename "$arquivo")"
		fi
	done
	# O cron do Debian não suporta CRON_TZ e interpreta a expressão sempre no
	# fuso do HOST. Imprimir os dois juntos evita o erro silencioso de agendar
	# "3h" achando que é horário de Brasília num servidor em UTC.
	printf 'fuso do servidor: %s (agora: %s)\n' \
		"$(timedatectl show --property=Timezone --value 2>/dev/null || readlink -f /etc/localtime)" \
		"$(date '+%F %T %Z')"
	crontab -l 2>/dev/null | grep 'stacktrack/scripts/backup.sh' \
		|| echo "aviso: backup do stacktrack não está agendado — rode make infra-apply" >&2
	;;

*)
	recusa "verbo desconhecido: ${verbo:-<vazio>}"
	;;
esac

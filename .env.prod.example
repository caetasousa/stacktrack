# Modelo do .env da stack — o arquivo de verdade fica SÓ no servidor, nunca no git.
# Quem o escreve é o `make infra-apply` (roles/stacktrack/templates/env.j2);
# este modelo serve para ler o que cada variável faz.
#
# No servidor:
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod        # senha de banco não é leitura para todo mundo
#   openssl rand -hex 24       # gera a POSTGRES_PASSWORD

# Domínio público desta aplicação. Precisa ser um SUBDOMÍNIO próprio: o cookie
# de sessão tem Path=/ e o prefixo __Host- amarra o cookie a um host exato — um
# domínio dedicado é o que garante que nenhum vizinho receba o token de quem
# entrou aqui.
#
# Precisa bater EXATAMENTE com o hostname da rota do túnel na Cloudflare.
DOMINIO=stacktrack.d4ffy.com

# Banco de dados. A senha vale para o initdb do primeiro boot: trocá-la depois
# exige alterar o usuário dentro do container, não basta editar aqui.
POSTGRES_DB=stacktrack
POSTGRES_USER=stacktrack
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria

# Usuário da APLICAÇÃO — só DML, sem DDL. Quem migra é o dono acima, pelo
# Flyway; a API usa este, que não pode criar, alterar nem derrubar tabela.
#
# O papel é criado por deploy/postgres/papeis.sql, aplicado pelo playbook. Ao
# contrário dos três de cima, que o initdb gravou no volume, a senha DESTE é
# gerenciada pelo vault: trocá-la é editar o vault e reaplicar.
#
# Deixar as duas vazias faz a API cair no dono do banco — que funciona, e é
# exatamente o poder que não se quer no processo que atende a internet. Ver
# docs/producao.md.
DB_USER=stacktrack_app
DB_PASSWORD=troque-por-uma-senha-aleatoria

# Imagens publicadas à mão no GitHub Container Registry (docs/entrega-continua.md).
# IMAGE_TAG=latest segue a main. Para fixar uma versão — ou voltar atrás —,
# troque pela tag do commit e suba de novo:  IMAGE_TAG=sha-abc1234
IMAGE_REPO=ghcr.io/caetasousa
IMAGE_TAG=latest

# Envio de email dos convites (Brevo, por SMTP). Com SMTP_HOST vazio o envio
# fica desligado e o convite sai só com o link manual — nada mais muda. Em
# produção a API recusa subir com SMTP sem TLS (SMTP_STARTTLS=false), sem
# EMAIL_CHAVE válida ou com usuário sem senha.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Só o endereço, sem nome. Precisa estar verificado no provedor.
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=stacktrack
# A chave que cifra a fila de emails — o link do convite fica guardado nela até
# sair. Gere com: openssl rand -base64 32
EMAIL_CHAVE=

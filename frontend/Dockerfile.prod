# Imagem de PRODUÇÃO do frontend: compila com o adapter-node e roda o servidor
# Node autônomo gerado em build/. Em desenvolvimento o compose continua usando
# o `npm run dev` pelo Vite.
#
# Node 24 porque é o LTS ativo: imagem de produção não roda em versão fora do
# LTS, que deixa de receber correção de segurança e vira CVE sem conserto na
# varredura do Trivy. Os dois estágios usam a MESMA versão de propósito —
# compilar numa e rodar em outra esconde incompatibilidade até a hora errada.

FROM node:24-alpine AS build

WORKDIR /app

# npm ci (e não install) instala exatamente o que está no lock e nunca o
# reescreve — build reproduzível é o ponto todo de ter lock.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# A URL da API é resolvida em tempo de BUILD (import.meta.env do Vite) e vai
# embutida no bundle que o navegador baixa — por isso é ARG, e não variável de
# runtime. O padrão é relativo para a imagem não ficar amarrada a um domínio:
# como o nginx da borda serve frontend e API na mesma origem, o navegador resolve `/api`
# para o domínio corrente. Funciona porque toda página que chama a API declara
# `ssr = false`, ou seja, o fetch nunca roda no servidor Node — onde um caminho
# relativo não teria base.
ARG PUBLIC_API_URL=/api
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

RUN npm run build

FROM node:24-alpine

WORKDIR /app
ENV NODE_ENV=production

# O servidor do adapter-node roda com `node build`: npm, npx, yarn e corepack
# não são usados em runtime, mas vêm na imagem base e carregam as próprias
# dependências — é de dentro do npm que sai o `tar` que o Trivy acusa como
# CRITICAL. Aqui a correção é REMOVER, não atualizar: não existe versão
# corrigida de uma dependência que não deveria estar na imagem.
#
# De quebra, o container fica sem gerenciador de pacotes nenhum, que é o que se
# quer em produção.
RUN rm -rf /usr/local/lib/node_modules/npm \
	/usr/local/lib/node_modules/corepack \
	/usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
	/opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

# Só a saída do adapter-node. Ela é autocontida: o Rollup embute as
# dependências no bundle, então não há node_modules a copiar — o que também
# tira da imagem tudo o que o Trivy varreria ali.
COPY --from=build /app/build ./build

# A imagem node já traz o usuário `node`, sem privilégio.
USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
	CMD wget --quiet --spider http://127.0.0.1:3000/ || exit 1

CMD ["node", "build"]

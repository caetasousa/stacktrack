# Bloco de site do stacktrack, para o Caddy que já serve o agendaGo no mesmo VPS.
#
# Quem instala é o job `implantar` da esteira: ele copia este arquivo para
# /home/deploy/caddy/sites/ e recarrega o Caddy — mas SÓ quando o conteúdo muda,
# porque o proxy pertence ao agendaGo e recarregá-lo a cada deploy daqui seria
# mexer, sem motivo, num processo que atende outro serviço em produção.
#
# O Caddyfile do agendaGo faz `import /etc/caddy/sites/*.caddy` e enxerga este
# arquivo pelo bind mount. Assim o stacktrack não precisa ser mencionado lá: o
# vizinho entra e sai sem editar a configuração de quem já estava.
#
# Os containers são alcançados pela rede Docker `borda`, que o CI do agendaGo
# cria de forma idempotente a cada deploy.
#
# Para instalar à mão (servidor novo, ou antes da primeira esteira):
#
#   cp deploy/caddy/stacktrack.caddy /home/deploy/caddy/sites/
#   docker exec $(docker ps --filter label=com.docker.compose.service=caddy \
#     --format '{{.Names}}' | head -1) caddy reload --config /etc/caddy/Caddyfile

stacktrack.duckdns.org {
	encode gzip zstd

	# Os mesmos cabeçalhos do agendaGo, pelas mesmas razões. A
	# Content-Security-Policy NÃO fica aqui: quem a emite é o SvelteKit, que
	# sabe o hash dos scripts que ele mesmo gerou naquele build. Duas CSPs na
	# mesma resposta valem pela interseção, e a daqui quebraria o app na
	# primeira divergência.
	# O log de acesso do site, com o caminho SANITIZADO.
	#
	# Sem isto o Caddy registra a URL inteira, e a URL do convite carrega o
	# segredo: `/convite/<token>` e `/api/convites/<token>` iriam para o log em
	# texto puro, junto de todo caminho secreto que alguém tente adivinhar. A
	# aplicação já faz a sua parte (ver internal/pkg/logging), mas o log do
	# proxy é um SEGUNDO registro da mesma requisição — sanitizar só um dos dois
	# não sanitiza nada.
	#
	# O filtro NÃO é uma lista das rotas que carregam segredo, e essa é a
	# decisão importante. Uma lista só protege os caminhos que casam com ela:
	# `/convitess/<token>` — a rota certa errada por uma letra — não casaria,
	# levaria 404, e o token iria inteiro para o log. O mesmo vale para um
	# segredo tentado na raiz, `/<token>`.
	#
	# Em vez disso, redige pela FORMA do segredo: todo token deste sistema é
	# base64url de 256 bits, 43 caracteres de [A-Za-z0-9_-] (ver
	# internal/pkg/token). Qualquer corrida de 24 ou mais desses caracteres num
	# segmento é redigida, casando ou não com rota. `/` fica fora da classe, então
	# a redação nunca atravessa segmentos e a forma da rota continua legível.
	#
	# O preço é que UUIDs (36 caracteres) também são redigidos. É preço, e não
	# defeito: o id do quadro não ajuda a diagnosticar nada que o log da
	# aplicação — que registra o padrão da rota e o request_id — já não diga.
	log {
		format filter {
			wrap console
			fields {
				request>uri regexp "[A-Za-z0-9_-]{24,}" "REDACTED"
				# Referer pode conter a URL anterior inteira, inclusive token de
				# convite. O caminho principal sanitizado nao protege esse segundo
				# campo, entao ele nao entra no access log.
				request>headers>Referer delete
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Global de proposito: uma regra posterior nao pode sobrescrever a
		# protecao das paginas que carregam credenciais no caminho.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# O teto de upload da API é 10 MiB de arquivo mais 1 MiB de folga para o
	# cabeçalho multipart (config/server.go, maxBytesUpload). Um limite menor
	# aqui devolveria 413 antes de a API poder responder direito.
	request_body {
		max_size 11MB
	}

	# API sob /api/* — handle_path REMOVE o prefixo (/api/boards -> /boards).
	# É essa origem única que faz valer o cookie __Host- e a CSP em
	# `connect-src 'self'`, e é ela que vai cobrir o wss:// da fase 5 sem
	# nenhuma exceção nova.
	handle_path /api/* {
		reverse_proxy stacktrack-api:8080 {
			# X-Real-IP com o peer da conexão, que não é forjável pelo cliente:
			# sem isto o middleware IPReal veria sempre o IP do Caddy, e o
			# httprate limitaria o proxy inteiro como se fosse uma pessoa só.
			# header_up substitui qualquer valor que o cliente tenha mandado.
			header_up X-Real-IP {remote_host}

			# O WebSocket do quadro é transparente aqui — o Caddy faz o
			# upgrade sozinho e não impõe timeout de leitura à conexão. Do lado
			# Go não há mais o que derrubá-lo: ReadTimeout e WriteTimeout são
			# zero de propósito (config/server.go), porque valem para a conexão
			# inteira e cortariam uma conexão longa no meio.
		}
	}

	# Todo o resto é o frontend.
	handle {
		reverse_proxy stacktrack-web:3000
	}
}
